@model OCMS.Models.Complaint

<div class="container-fluid">

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h4 class="font-weight-bold mb-1">
                        @Model.Title
                    </h4>
                    <small class="text-muted">
                        Track ID: @Model.TrackId
                    </small>
                </div>

                @{
                    string badgeClass = "badge-secondary";

                    switch (Model.Status.ToString())
                    {
                        case "Resolved":
                            badgeClass = "badge-success";
                            break;
                        case "Pending":
                            badgeClass = "badge-primary";
                            break;
                        case "Rejected":
                            badgeClass = "badge-danger";
                            break;
                        case "InProgress":
                            badgeClass = "badge-warning";
                            break;
                    }
                }

                <span class="badge @badgeClass status-badge">
                    @Model.Status
                </span>

            </div>

        </div>
    </div>

    <div class="row">

        <div class="col-md-6 mb-3">
            <div class="info-card category-card">
                <div class="info-icon">
                    <i class="fa fa-list-alt"></i>
                </div>

                <div>
                    <small>Category</small>
                    <h5>@Model.Category</h5>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="info-card date-card">
                <div class="info-icon">
                    <i class="fa fa-calendar"></i>
                </div>

                <div>
                    <small>Submission Date</small>
                    <h5>
                        @Model.SubmissionDate.ToString()
                    </h5>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="fa fa-align-left mr-2"></i>
                Complaint Description
            </h5>
        </div>

        <div class="card-body">
            <p class="description-text">
                @Model.Description
            </p>
        </div>
    </div>

</div>