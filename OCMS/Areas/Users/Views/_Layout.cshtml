@{
    string displayName = "";
    if (User.Identity.IsAuthenticated)
    {
        var userSvc = new OCMS.Services.UsersServices();
        var currentUser = userSvc.GetById(Guid.Parse(User.Identity.Name));
        displayName = currentUser != null ? currentUser.FullName.Split(' ')[0] : "User";
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Complaint Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/Asset/UserAsset/css/main.css" />
</head>
<body>

    <div id="ajaxLoader" class="ajax-loader">
        <div class="spinner-border loader-spinner" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p>Please wait...</p>
    </div>

    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmModalTitle">Are you sure?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="confirmModalBody">
                    Are you sure you want to proceed?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmModalBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <div class="status-ticker bg-light py-2">
        <div class="container">
            <div class="ticker-content">
                <span class="badge bg-success me-2">Resolved</span>
                <span>Complaint #C-1254 (Water Leakage) was resolved today</span>
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <div class="logo">
                <h1>Online<span> Complaint</span></h1>
            </div>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-links" href="/Visitors/Home/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-links" href="/Visitors/Home/About">About</a>
                        </li>
                        <li class="nav-item ms-lg-3">
                            <a class="logins-btn" href="/Users/Auth/Login">Login</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-links" href="/Visitors/Home/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-links" href="/Visitors/Complaint/ComplaintPage">Submit</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-links" href="/Visitors/Complaint/TrackComplaintPage">Track</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-links" href="/Visitors/Home/About">About</a>
                        </li>
                       
                        if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-links" href="/Admin/UserManager/Index">Admin Panel</a>
                            </li>
                        }
                        <li class="nav-item ms-lg-3 dropdown" id="userDropdown">
                            <a class="user-menu-btn" href="#" id="userMenuToggle">
                                <div class="user-avatar-circle">
                                    <i class="fas fa-user"></i>
                                </div>
                                <span class="user-menu-name">@displayName</span>
                                <i class="fas fa-chevron-down user-menu-arrow"></i>
                            </a>
                            <ul class="user-dropdown-menu" id="userDropdownMenu">
                                <li>
                                    <a href="/Users/Profile/Index" class="user-dropdown-item">
                                        <i class="fas fa-user-circle"></i>
                                        <span>My Profile</span>
                                    </a>
                                </li>
                                <li class="user-dropdown-divider"></li>
                                <li>
                                    <a href="#" class="user-dropdown-item user-dropdown-logout" onclick="confirmLogout(event)">
                                        <i class="fas fa-sign-out-alt"></i>
                                        <span>Logout</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <!-- Add User Modal -->
    <div class="modal fade" id="addUserModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">

                <div class="modal-header" style="background:#1b82ec;">
                    <h5 class="modal-title text-white">
                        <i class="mdi mdi-account-plus mr-2"></i> Add New User
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal">
                        <span>&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <form id="addUserForm" enctype="multipart/form-data" novalidate>

                        <div class="form-group">
                            <label>Full Name</label>
                            <input type="text" id="au_fullName" name="FullName"
                                   class="form-control" placeholder="Enter full name" required>
                            <div class="invalid-feedback">Full name is required</div>
                        </div>

                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" id="au_email" name="Email"
                                   class="form-control" placeholder="Enter email" required>
                            <div class="invalid-feedback">Valid email is required</div>
                        </div>

                        <div class="form-group">
                            <label>Password</label>
                            <input type="password" id="au_password" name="Password"
                                   class="form-control" placeholder="Enter password" required>
                            <div class="invalid-feedback">Password is required</div>
                        </div>

                        <div class="form-group">
                            <label>Profile Image</label>
                            <input type="file" id="au_image" name="ImageFile"
                                   class="form-control-file" accept="image/*">
                        </div>

                    </form>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary waves-effect"
                            data-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" id="saveUserBtn" class="btn btn-primary waves-effect waves-light">
                        <i class="mdi mdi-content-save mr-1"></i> Save User
                    </button>
                </div>

            </div>
        </div>
    </div>
    <div>
        @RenderBody()
    </div>

    <footer>
        <div class="footer-container">
            <div class="footer-content">
                <div class="footer-column">
                    <h3>Quick Links</h3>
                    <ul>
                        <li><a href="/Visitors/Home/Index">Home</a></li>
                        <li><a href="/Visitors/Home/About">About Us</a></li>
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li><a href="/Users/Auth/RegistrationPage">Registration</a></li>
                        }
                        <li><a href="#">Events</a></li>
                    </ul>
                </div>
                <div class="footer-column">
                    <h3>Support</h3>
                    <ul>
                        <li><a href="#">FAQs</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms of Service</a></li>
                        <li><a href="#">Contact Us</a></li>
                    </ul>
                </div>
                <div class="footer-column">
                    <h3>Contact Info</h3>
                    <ul>
                        <li><i class="fas fa-map-marker-alt"></i> Dera Ismail Khan</li>
                        <li><i class="fas fa-phone"></i> +92 300 0000000</li>
                        <li><i class="fas fa-envelope"></i> support@complaintsystem.com</li>
                    </ul>
                </div>
            </div>
            <hr>
            <div class="text-center">
                <p class="mb-0">&copy; @DateTime.Now.Year Complaint Management System. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3"
         style="z-index: 2000; margin-top: 90px; width: auto; max-width: 400px;">
        <div id="mainToast" class="toast align-items-center text-white border-0 shadow-lg"
             role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div id="toastMessage" class="toast-body"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Asset/UserAsset/js/jquery.min.js"></script>
    <script src="~/Asset/UserAsset/js/script1.js"></script>
    <script>

        function showToast(message, type) {
            type = type || "info";
            var toastEl = document.getElementById('mainToast');
            var toastBody = document.getElementById('toastMessage');

            toastEl.classList.remove("toast-success", "toast-error", "toast-info");
            toastEl.classList.add("toast-" + type);

            var icons = {
                success: '<i class="fas fa-check-circle me-2"></i>',
                error: '<i class="fas fa-times-circle me-2"></i>',
                info: '<i class="fas fa-info-circle me-2"></i>'
            };

            toastBody.innerHTML = (icons[type] || '') + message;

            var existing = bootstrap.Toast.getInstance(toastEl);
            if (existing) existing.dispose();

            var toast = new bootstrap.Toast(toastEl, { delay: 3500 });
            toast.show();
        }

        function showConfirm(options) {
            var title = options.title || 'Are you sure?';
            var message = options.message || 'Are you sure you want to proceed?';
            var btnText = options.btnText || 'Confirm';
            var btnClass = options.btnClass || 'btn-primary';
            var onConfirm = options.onConfirm || function () { };

            document.getElementById('confirmModalTitle').innerText = title;
            document.getElementById('confirmModalBody').innerText = message;

            var confirmBtn = document.getElementById('confirmModalBtn');
            confirmBtn.innerText = btnText;
            confirmBtn.className = 'btn ' + btnClass;

            var modalEl = document.getElementById('confirmModal');
            var modal = new bootstrap.Modal(modalEl);

            confirmBtn.onclick = function () {
                modal.hide();
                onConfirm();
            };

            modal.show();
        }

        function confirmLogout(e) {
            e.preventDefault();
            showConfirm({
                title: 'Logout',
                message: 'Are you sure you want to logout?',
                btnText: 'Logout',
                btnClass: 'btn-danger',
                onConfirm: function () {
                    window.location.href = '/Users/Auth/Logout';
                }
            });
        }

    </script>

    @RenderSection("scripts", required: false)
</body>
</html>