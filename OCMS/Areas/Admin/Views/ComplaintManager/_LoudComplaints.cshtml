@using OCMS.Common.CommonClasses.Enums
@model IEnumerable<OCMS.DTO_s.ComplaintDto_s.GetAllComplaintsDTO>

<table id="complaintsTable"
       class="table table-striped table-bordered dt-responsive nowrap w-100"
       style="width:100% !important">
    <thead class="thead-dark">
        <tr>
            <th>Track ID</th>
            <th>Title</th>
            <th>Category</th>
            <th>Status</th>
            <th>Submission Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string statusColor;
            if      (item.Status == ComplaintStatus.Resolved)   { statusColor = "background-color:#16e035;"; }
            else if (item.Status == ComplaintStatus.Rejected)   { statusColor = "background-color:#e81c1c;"; }
            else if (item.Status == ComplaintStatus.InProgress) { statusColor = "background-color:#de9d23;"; }
            else if (item.Status == ComplaintStatus.Pending)    { statusColor = "background-color:#3a9bd5;"; }
            else                                                { statusColor = "background-color:#6c757d;"; }

            <tr>
                <td>@item.TrackId</td>
                <td>@item.Title</td>
                <td>@item.Category</td>
                <td>
                    <select style="@statusColor color:white; border:none; border-radius:4px; padding:4px 8px;"
                            class="form-control form-control-sm"
                            onchange="UpdateCompStatus('@item.ComplaintId', this.value)">
                        <option value="@((int)ComplaintStatus.Pending)"
                                @(item.Status == ComplaintStatus.Pending ? "selected" : "")>
                            Pending
                        </option>
                        <option value="@((int)ComplaintStatus.Resolved)"
                                @(item.Status == ComplaintStatus.Resolved ? "selected" : "")>
                            Resolved
                        </option>
                        <option value="@((int)ComplaintStatus.InProgress)"
                                @(item.Status == ComplaintStatus.InProgress ? "selected" : "")>
                            InProgress
                        </option>
                        <option value="@((int)ComplaintStatus.Rejected)"
                                @(item.Status == ComplaintStatus.Rejected ? "selected" : "")>
                            Rejected
                        </option>
                    </select>
                </td>
                <td>@item.SubmissionDate</td>

                <td>
                    <button type="button"
                            class="btn btn-info btn-sm"
                            onclick="ViewComplaint('@item.ComplaintId')">
                        <i class="fa fa-eye"></i> View
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>