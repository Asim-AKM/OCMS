@using OCMS.Common.CommonClasses.Enums
@{
    ViewBag.Title = "Update Password";
    Layout = "~/Areas/Users/Views/_Layout.cshtml";
}

<section class="login-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="login-card">
                    <div class="login-header">
                        <h2>Update Password</h2>
                        <p>Enter the OTP you received and set a new password</p>
                    </div>

                    <form id="updatePasswordForm" novalidate>
                        <input type="hidden" name="UserId" value="@TempData["userId"]" />

                        <div class="form-group">
                            <label for="otp">OTP Code</label>
                            <input type="text" id="otp" name="Otp"
                                   required placeholder="Enter OTP received on email">
                            <div class="invalid-feedback">OTP is required</div>
                        </div>

                        <div class="form-group">
                            <label for="newPassword">New Password</label>
                            <input type="password" id="newPassword" name="NewPassword"
                                   required placeholder="Enter new password">
                            <div class="invalid-feedback">New password is required</div>
                        </div>

                        <div class="form-group">
                            <label for="confirmPassword">Confirm Password</label>
                            <input type="password" id="confirmPassword"
                                   required placeholder="Confirm new password">
                            <div class="invalid-feedback">Passwords must match</div>
                        </div>

                        <button type="submit" id="updateBtn" class="login-btn">
                            Update Password
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script src="~/Asset/UserAsset/js/jquery.min.js"></script>
    <script>

        var updateBtn = $('#updateBtn');
        var updateBtnOriginal = updateBtn.html();

        function setBtnLoading() {
            updateBtn.html('<i class="fas fa-spinner fa-spin me-2"></i>Updating...').prop('disabled', true);
        }

        function resetBtn() {
            updateBtn.html(updateBtnOriginal).prop('disabled', false);
        }

        $('#updatePasswordForm').on('input', 'input', function () {
            $(this).removeClass('is-invalid');
            $(this).next('.invalid-feedback').text('');
        });

        function validateForm() {
            var isValid = true;

            $('#updatePasswordForm').find('[required]').each(function () {
                if (!$(this).val().trim()) {
                    $(this).addClass('is-invalid');
                    isValid = false;
                }
            });

            if ($('#newPassword').val() !== $('#confirmPassword').val()) {
                $('#confirmPassword').addClass('is-invalid');
                $('#confirmPassword').next('.invalid-feedback').text('Passwords must match');
                isValid = false;
            }

            return isValid;
        }

        $('#updatePasswordForm').on('submit', function (e) {
            e.preventDefault();

            if (!validateForm()) {
                showToast("Please fix the errors below.", "error");
                return;
            }

            setBtnLoading();

            var frmData = new FormData(document.getElementById('updatePasswordForm'));

            $.ajax({
                type: 'POST',
                url: '@Url.Action("UpdateNewPassword", "Auth", new { area = "Users" })',
                data: frmData,
                processData: false,
                contentType: false,
                success: function (result) {
                    resetBtn();
                    if (result == @((int)OperationResponse.Success)) {
                        showToast("Password updated successfully! Redirecting...", "success");
                        setTimeout(function () {
                            window.location.href = "/Users/Auth/Login";
                        }, 1500);
                    } else {
                        showToast("Invalid OTP or request failed. Please try again.", "error");
                    }
                },
                error: function () {
                    resetBtn();
                    showToast("Server error. Please try again later.", "error");
                }
            });
        });

    </script>
}